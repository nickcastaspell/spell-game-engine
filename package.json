{
  "name": "spell-game-engine",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/shared-types && npm run build --workspace=packages/game-core && npm run build --workspace=apps/server",
    "dev": "npm run dev --workspace=apps/server",
    "start": "npm run seed && npm run start --workspace=apps/server",
    "seed": "tsx apps/server/src/seed.ts",
    "test": "vitest run",
    "simulate": "tsx tests/integration/simulate.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.4",
    "@types/node": "^22.10.0",
    "@types/express": "^4.17.21"
  },
  "dependencies": {
    "express": "^4.21.1",
    "nanoid": "^3.3.7",
    "zod": "^3.23.8"
  }
}
